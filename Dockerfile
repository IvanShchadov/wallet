# ---------- Этап 1: сборка ----------
# Конкретная версия, а не latest: сборка не сломается сама, когда выйдет новый Go
FROM golang:1.26-alpine AS build
WORKDIR /src

# Сначала только файлы зависимостей и их скачивание — отдельным слоем.
# Docker кэширует слои: пока go.mod не менялся, этот шаг не повторяется,
# и пересборка после правки кода идёт быстро.
# go.* — это go.mod и go.sum; go.sum появится, когда добавим первую библиотеку

COPY go.* ./
RUN go mod download

# Теперь весь код и сборка. CGO_ENABLED=0 — бинарник без зависимостей от системных библиотек
COPY . .
RUN CGO_ENABLED=0 go build -o /bin/api ./cmd/api

# ---------- Этап 2: запуск ----------
# Лёгкий образ: компилятора и исходников здесь нет, только бинарник из этапа build
FROM alpine:3.22
COPY --from=build /bin/api /bin/api

# Запускаем не от root: если сервис взломают, у процесса будет минимум прав
RUN adduser -D -u 10001 app
USER app

# Документация: сервис слушает 8080. Порт наружу открывает -p при запуске
EXPOSE 8080

# Exec-форма в квадратных скобках: api становится главным процессом контейнера
# и сам получает SIGTERM от docker stop — срабатывает graceful shutdown
ENTRYPOINT ["/bin/api"]
